NODE_ENV=development
PORT=4001
DATABASE_URL=postgresql://blibli:blibli@localhost:5432/blibli_talk_admin_split?schema=public
# Production requires a random value of at least 32 characters (see src/config.ts). Any
# non-empty, non-placeholder value works for local dev.
ADMIN_JWT_SECRET=dev-only-change-me
COOKIE_NAME=blibli_talk_session
LOG_LEVEL=info
PUBLIC_FE_ORIGIN=http://localhost:5183
ADMIN_FE_ORIGIN=http://localhost:5184
# Local dev credential for accounts created by `pnpm db:seed` (superadmin@gdn-commerce.com,
# eventadmin@gdn-commerce.com, demo@gdn-commerce.com). Never a real password — pick anything.
SEED_ADMIN_PASSWORD=changeme-for-local-dev
