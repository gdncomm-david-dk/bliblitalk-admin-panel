NODE_ENV=development
PORT=4001
DATABASE_URL=postgresql://blibli:blibli@localhost:5432/blibli_talk_admin_split?schema=public
LOG_LEVEL=info
ADMIN_FE_ORIGIN=http://localhost:5184
# No JWT_SECRET, COOKIE_NAME or SEED_ADMIN_PASSWORD since the Apps Gateway migration
# (2026-08-06): this app issues no session, verifies no token, and stores no password.
# The gateway authenticates at the edge and forwards the user's email in X-User-Id;
# locally, the admin frontend's DEV-only /dev-login supplies that header instead.
# bliblitalk-user-fe still needs its own JWT_SECRET/COOKIE_NAME for participant sessions.

# SMTP relay for marketing campaigns and event reminders (src/lib/shared/mailer.ts). Owned by
# Blibli's IT/infra team per docs/DESIGN.md External Connections — get real values from them.
# Leaving SMTP_HOST empty disables sending: isEmailConfigured() returns false and every send
# throws EMAIL_NOT_CONFIGURED_MESSAGE instead of silently failing.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Blibli Talk <noreply@blibli.com>
