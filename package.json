{
  "name": "bliblitalk-admin",
  "private": true,
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@9.7.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "node scripts/dev-db.mjs",
    "db:up:docker": "docker-compose up -d db",
    "db:generate": "pnpm --filter @repo/backend generate",
    "db:migrate": "pnpm --filter @repo/backend migrate",
    "db:seed": "pnpm --filter @repo/backend seed",
    "db:bootstrap-superadmin": "pnpm --filter @repo/backend bootstrap:superadmin"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "turbo": "^2.11.4",
    "typescript": "^5.5.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.9",
      "ip-address": "10.5.0",
      "js-yaml": "5.2.3",
      "nanoid": "6.0.1",
      "vite": "8.2.1"
    }
  }
}
