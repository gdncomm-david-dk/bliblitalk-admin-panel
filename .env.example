# Local Docker Compose variables for docker-compose.yml at this same path — separate from
# apps/backend/.env, which configures the Node app directly and is used by `pnpm dev` without
# Docker. Copy this file to `.env` in this directory; docker-compose reads it automatically and
# it is gitignored, so nothing here is ever committed.
POSTGRES_USER=blibli
POSTGRES_PASSWORD=changeme-for-local-dev
POSTGRES_DB=blibli_talk
