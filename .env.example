# ---- Backend (apps/backend) ----
NODE_ENV=development
PORT=4000
# Postgres 15 connection (matches docker-compose service "db")
DATABASE_URL=postgresql://blibli:blibli@localhost:5432/blibli_talk?schema=public
# Auth (JWT session, shared by participant + admin logins issued by this backend).
ADMIN_JWT_SECRET=dev-only-change-me
COOKIE_NAME=blibli_talk_session
LOG_LEVEL=info
# CORS allow-list — set to the real deployed origins in non-dev environments.
PUBLIC_FE_ORIGIN=http://localhost:5173
ADMIN_FE_ORIGIN=http://localhost:5174
# Email (optional). Sending is skipped (recorded as failed) if SMTP_HOST is unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Blibli Talk <noreply@blibli.com>

# ---- Admin frontend (apps/frontend) ----
# Same-origin in prod (served by the backend). Dev uses the Vite proxy.
# Page call sites already say "/admin/..." (e.g. api.post("/admin/events")), so
# this stays "/api" — NOT "/api/admin", which would double the admin segment.
VITE_API_BASE_URL=/api
